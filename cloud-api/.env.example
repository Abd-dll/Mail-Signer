# ─── Base de données PostgreSQL (Railway injecte DATABASE_URL automatiquement) ───
DATABASE_URL=postgresql://user:password@host:5432/railway

# ─── JWT ─────────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplace_par_une_chaine_aleatoire_longue_64_bytes_hex

# ─── NextCloud WebDAV ─────────────────────────────────────────────────────────────
NEXTCLOUD_URL=https://votre-nextcloud.example.com/remote.php/dav/files/VOTRE_USER/
NEXTCLOUD_USER=votre_utilisateur_nextcloud
NEXTCLOUD_PASS=votre_mot_de_passe_ou_app_token

# ─── Serveur ──────────────────────────────────────────────────────────────────────
PORT=3000

# ─── Chiffrement at rest (AES-256-GCM) ───────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NE JAMAIS committer cette valeur — uniquement dans les variables Railway
MASTER_KEY_HEX=remplace_par_32_bytes_hex_soit_64_chars
